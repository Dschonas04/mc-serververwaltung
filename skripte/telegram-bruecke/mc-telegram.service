[Unit]
Description=Brücke studiserver4-Chat <-> Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=amp
EnvironmentFile=/etc/mc-telegram.env
StateDirectory=mc-telegram
ExecStart=/usr/bin/python3 /opt/mc-telegram/mc-telegram.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
